    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="View\Paginas\BaixaMaterial.xaml.cs" />
    <Compile Remove="View\Paginas\ConsultaSimplificadaMaterial.xaml.cs" />
