<Window x:Class="ControleMaterialIBAA.View.Janelas.PopupEstocarMaterial"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estocar Material"
        Height="387"
        Width="400"
        Background="#E8F0F0"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <TextBlock Text="Estocar Material"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- QUANTIDADE -->
        <StackPanel Grid.Row="1" Margin="0,5">
            <TextBlock Text="Quantidade:" FontWeight="Bold"/>
            <TextBox x:Name="TxtQuantidade"
                     Height="30"/>
        </StackPanel>

        <!-- RESPONSÁVEL -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Responsável:" FontWeight="Bold"/>
            <TextBox x:Name="TxtResponsavel"
                     Height="30"/>
        </StackPanel>

        <!-- OBSERVAÇÃO -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Observação:" FontWeight="Bold"/>
            <TextBox x:Name="TxtObservacao"
                     Height="80"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <!-- BOTÕES -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,85,0" Width="196">

            <Button Content="Cancelar"
                    Width="90"
                    Height="30"
                    Background="#A94442"
                    Foreground="White"
                    Click="BtnCancelar_Click"/>

            <Button Content="Confirmar"
                    Width="90"
                    Height="30"
                    Margin="5"
                    Background="#2E8B57"
                    Foreground="White"
                    Click="BtnConfirmar_Click"/>
        </StackPanel>

    </Grid>
</Window>