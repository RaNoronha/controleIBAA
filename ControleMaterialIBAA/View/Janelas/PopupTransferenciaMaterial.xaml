<Window x:Class="ControleMaterialIBAA.View.Janelas.PopupTransferenciaMaterial"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transferência de Material"
        Height="720"
        Width="500"
        Background="#E8F0F0"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 🔥 Materiais -->
            <TextBlock Text="Materiais Selecionados"
                       FontWeight="Bold"
                       FontSize="14"
                       Foreground="#2F4F4F"/>

            <ListBox x:Name="LstMateriais"
                     Grid.Row="1"
                     Margin="0,5,0,10"
                     DisplayMemberPath="nome"/>

            <!-- 🔥 Origem -->
            <StackPanel Grid.Row="2" Margin="0,5">
                <TextBlock Text="Departamento Atual" FontWeight="Bold"/>
                <TextBox x:Name="TxtDepartamentoOrigem" IsReadOnly="True"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,5">
                <TextBlock Text="SubDepartamento Atual" FontWeight="Bold"/>
                <TextBox x:Name="TxtSubDepartamentoOrigem" IsReadOnly="True"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,5">
                <TextBlock Text="Responsável Atual" FontWeight="Bold"/>
                <TextBox x:Name="TxtResponsavelOrigem" IsReadOnly="True"/>
            </StackPanel>

            <!-- 🔥 DESTINO -->
            <StackPanel Grid.Row="5" Margin="0,5">
                <TextBlock Text="Novo Departamento" FontWeight="Bold"/>
                <ComboBox x:Name="CmbDepartamentoDestino"
                          DisplayMemberPath="nome"
                          SelectedValuePath="id"
                          SelectionChanged="CmbDepartamentoDestino_SelectionChanged"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Margin="0,5">
                <TextBlock Text="Novo SubDepartamento" FontWeight="Bold"/>
                <ComboBox x:Name="CmbSubDepartamentoDestino"
                          DisplayMemberPath="nome"
                          SelectedValuePath="id"/>
            </StackPanel>

            <!-- 🔵 QUANTIDADE (CONSUMO) -->
            <StackPanel x:Name="PanelQuantidade" Grid.Row="7" Margin="0,5">
                <TextBlock Text="Quantidade" FontWeight="Bold"/>
                <TextBox x:Name="TxtQuantidade"/>
            </StackPanel>

            <!-- 🟢 PATRIMÔNIOS (PERMANENTE) -->
            <StackPanel x:Name="PanelPatrimonios" Grid.Row="8" Margin="0,5" Visibility="Collapsed">

                <TextBlock Text="Selecione os Patrimônios"
                           FontWeight="Bold"
                           Margin="0,5"/>

                <DataGrid x:Name="DgPatrimonios"
                          AutoGenerateColumns="False"
                          Height="200"
                          CanUserAddRows="False">

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Sel" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding selecionado, Mode=TwoWay}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Nº"
                                            Binding="{Binding numeroPatrimonial}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Departamento"
                                            Binding="{Binding departamentoNome}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Responsável"
                                            Binding="{Binding responsavel}"
                                            Width="150"/>

                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <!-- 🔥 RESPONSÁVEL + OBS -->
            <StackPanel Grid.Row="9" Margin="0,10,0,0">

                <TextBlock Text="Novo Responsável" FontWeight="Bold"/>
                <TextBox x:Name="TxtResponsavelDestino"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Observação" FontWeight="Bold"/>
                <TextBox x:Name="TxtObservacao"
                         Height="60"
                         TextWrapping="Wrap"
                         Margin="0,5,0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <Button x:Name="BtnConfirmar"
                            Content="Confirmar"
                            Width="120"
                            Height="35"
                            Margin="5"
                            Background="#3E6F6F"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="BtnConfirmar_Click"/>

                    <Button x:Name="BtnCancelar"
                            Content="Cancelar"
                            Width="120"
                            Height="35"
                            Margin="5"
                            Background="#A94442"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="BtnCancelar_Click"/>
                </StackPanel>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Window>